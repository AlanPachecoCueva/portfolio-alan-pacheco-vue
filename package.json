{
  "name": "ap-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint . --ext .vue,.js"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@iconify/vue": "^4.1.2",
    "@mdi/font": "^7.4.47",
    "@nuxtjs/i18n": "^10.6.0",
    "firebase": "^12.19.0",
    "nuxt": "^4.6.4",
    "vue": "^3.2.13",
    "vue-router": "^4.4.2",
    "vue-sweetalert2": "^5.0.11",
    "vuetify": "^3.7.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "es2022": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "ignorePatterns": [
      "dist/",
      ".output/",
      ".nuxt/",
      "node_modules/",
      "src/views/admin/"
    ],
    "globals": {
      "defineNuxtConfig": "readonly",
      "defineNuxtPlugin": "readonly",
      "defineNuxtRouteMiddleware": "readonly",
      "definePageMeta": "readonly",
      "navigateTo": "readonly",
      "useState": "readonly",
      "useHead": "readonly",
      "useSeoMeta": "readonly",
      "useRuntimeConfig": "readonly",
      "useRoute": "readonly",
      "useRouter": "readonly",
      "useNuxtApp": "readonly",
      "useAsyncData": "readonly",
      "useFetch": "readonly",
      "useI18n": "readonly",
      "useLocalePath": "readonly",
      "useLocaleHead": "readonly",
      "useCookie": "readonly"
    },
    "overrides": [
      {
        "files": [
          "layouts/**/*.vue",
          "pages/**/*.vue",
          "app.vue",
          "error.vue"
        ],
        "rules": {
          "vue/multi-word-component-names": "off"
        }
      }
    ],
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
